rules_version = '2';

// Reglas de seguridad de Booking Artist.
// Se pegan en Consola de Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // Datos de la cuenta: solo su dueño.
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    // Página pública del artista: todos la ven, solo el artista la cambia.
    // createdAt (desde cuándo cuenta su mes gratis) se pone al crear la
    // página y no se puede cambiar después.
    match /artists/{uid} {
      allow read: if true;
      allow create: if signedIn() && me() == uid &&
        (!('createdAt' in request.resource.data) ||
         (request.resource.data.createdAt is int &&
          request.resource.data.createdAt > request.time.toMillis() - 600000 &&
          request.resource.data.createdAt < request.time.toMillis() + 600000));
      allow update: if signedIn() && me() == uid &&
        request.resource.data.get('createdAt', 0) == resource.data.get('createdAt', 0);
      allow delete: if signedIn() && me() == uid;
    }

    // Suscripción de $10 al mes de cada artista: todos la leen (para saber
    // quién aparece en la app); solo el servidor (/api/subscribe) la escribe.
    match /subscriptions/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Cliente de Stripe de cada artista: solo el servidor.
    match /billing/{uid} {
      allow read, write: if false;
    }

    // Horas ocupadas (sin datos del cliente), para mostrar horarios libres.
    match /busy/{bookingId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.clientUid == me();
      allow update, delete: if signedIn() &&
        (resource.data.clientUid == me() || resource.data.artistId == me());
    }

    // Reservas: solo el cliente que la hizo y el artista reservado.
    // Una reserva nueva empieza sin pagar (porPagar). El pago, el monto y el
    // estado de las reservas con cobro real solo los cambia el servidor de
    // pagos (/api/pay). Las de pago simulado se pueden cambiar desde la app.
    function party() {
      return resource.data.clientUid == me() || resource.data.artistId == me();
    }
    match /bookings/{id} {
      allow create: if signedIn() && request.resource.data.clientUid == me() &&
        request.resource.data.status == 'pendiente' &&
        request.resource.data.payment in ['porPagar', 'simulado'];
      allow read: if signedIn() && party();
      allow update: if signedIn() && party() &&
        resource.data.payment == 'simulado' &&
        request.resource.data.payment == 'simulado';
    }

    // Datos internos de cada cobro (Stripe / ATH Móvil): solo el servidor.
    match /payments/{id} {
      allow read, write: if false;
    }

    // Reseñas: todos las leen. Solo el cliente de una reserva confirmada
    // cuyo evento ya pasó puede dejarla (una por reserva) y cambiarla.
    function reviewOk(bookingId) {
      let b = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      let r = request.resource.data;
      return b.clientUid == me() && b.status == 'confirmada' &&
        b.start + b.hours * 3600000 < request.time.toMillis() &&
        r.clientUid == me() && r.artistId == b.artistId &&
        r.rating is int && r.rating >= 1 && r.rating <= 5 &&
        r.text is string && r.text.size() <= 600 &&
        r.clientName is string && r.clientName.size() <= 120;
    }
    match /reviews/{bookingId} {
      allow read: if true;
      allow create, update: if signedIn() && reviewOk(bookingId);
      allow delete: if signedIn() && resource.data.clientUid == me();
    }

    // Chats: solo las dos personas de la conversación.
    match /conversations/{id} {
      allow read, update: if signedIn() &&
        (resource.data.clientUid == me() || resource.data.artistId == me());
      allow create: if signedIn() &&
        (request.resource.data.clientUid == me() ||
         request.resource.data.artistId == me());
    }

    // Avisos: cualquiera con cuenta puede enviar; solo el destinatario los lee.
    match /notifications/{id} {
      allow create: if signedIn();
      allow read, update: if signedIn() &&
        resource.data.recipientEmail == request.auth.token.email;
    }
  }
}
